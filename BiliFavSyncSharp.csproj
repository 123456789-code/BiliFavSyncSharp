<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Version>1.5.0</Version>
		<ApplicationIcon>Assets\App.ico</ApplicationIcon>
		<SatelliteResourceLanguages>zh-Hans;zh-CN</SatelliteResourceLanguages>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<DefaultItemExcludes>$(DefaultItemExcludes);.local/**;artifacts/**;tests/**;vendor/**</DefaultItemExcludes>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="QRCoder" Version="1.7.0" />
		<ProjectReference Include="vendor/BBDown/BBDown.csproj" />
		<EmbeddedResource Include="Assets\App.ico" />
		<Content Include=".local\bundled-media\**\*" Link="tools\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
